{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:disableTypesNodeMajor",
    "security:openssf-scorecard",
    ":enableVulnerabilityAlerts",
    ":automergeStableNonMajor",
    "group:linters"
  ],
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Hold TypeScript on the 5.x line: typescript-eslint and typedoc do not support the TypeScript 7 native compiler yet (typescript-eslint#10940). Remove this cap once they do.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
