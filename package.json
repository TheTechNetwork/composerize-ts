{
  "name": "@unabandoned/composerize-ts",
  "version": "0.9.3",
  "description": "Turns docker run commands into docker-compose files!",
  "keywords": [
    "docker",
    "docker-compose",
    "converter"
  ],
  "author": "Carsten Götzinger <info@cgo-it.de> (https://cgo-it.de)",
  "homepage": "https://github.com/unabandoned/composerize-ts#readme",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run lint && rm -rf dist && tsc && tsc --build tsconfig.esm.json && npm run doc",
    "lint": "eslint .",
    "doc": "typedoc",
    "prepublishOnly": "rm -rf dist && rm -rf docs && npm run build && npm test",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/composerize-ts.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/composerize-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "bin": {
    "composerize-ts": "./cli.js"
  },
  "files": [
    "dist/",
    "cli.js"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "ip-address": "10.7.2",
    "set-value": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.3",
    "@types/set-value": "4.0.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
